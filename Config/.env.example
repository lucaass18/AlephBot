# Copie para Config/.env e preencha. O arquivo real nunca vai pro git.

# discord
TOKEN=
PREFIX=!
# id do servidor de testes: marca o bot como em desenvolvimento (banner, log e /api/v1/status).
# Nao muda onde os slash commands sao registrados (sempre globais). Em producao
# (DOTNET_ENVIRONMENT=Production, como no compose) nao vale.
DEV_GUILD_ID=

# Geral
# Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information

# musica (Lavalink) — o Lavalink/application.yml deste repositorio ja usa estes valores
LAVALINK_URI=http://localhost:2333/
LAVALINK_PASSWORD=youshallnotpass
# minutos parado (sem ninguem no canal ou sem tocar) antes do bot sair
MUSIC_IDLE_MINUTES=2

# login do YouTube, reserva pra servidor: de IP de datacenter o YouTube barra o audio pro
# plugin do Lavalink, e quem toca sem conta e o yt-audio (abaixo); com o login, a faixa que
# ele nao conseguir ainda toca pelo plugin.
# Ligado, o bot pede o codigo no console quando nao tem token guardado, e guarda o token
# sozinho (no volume aleph-data). Pode deixar ligado: com token guardado ele nao pede nada,
# e so volta a pedir se o Google invalidar o token.
YOUTUBE_LOGIN=false

# o yt-audio, que toca o YouTube sem conta (yt-dlp + token anti-robo, saindo pelo WARP). O
# compose preenche sozinho (http://yt-audio:8080/); fora dele, vazio = o YouTube toca so
# pelo plugin do Lavalink
YOUTUBE_AUDIO_URI=

# anime (/ma): opcional. Vazio, o bot pergunta ao AniList (graphql.anilist.co), que nao pede
# chave. Com um Client ID a API oficial do MAL atende primeiro e o AniList fica de reserva
# pra quando ela cair. Pra criar um: https://myanimelist.net/apiconfig -> Create ID (App
# Type: other).
MAL_CLIENT_ID=

# API HTTP de status (/api/v1/status, /api/v1/stats, /api/v1/commands, /api/v1/health): opcional.
# Vazio = desligada, nenhuma porta abre. Com uma chave (minimo 16 caracteres) ela sobe; stats
# e commands pedem a chave no header X-Api-Key (health e status sao abertos). Gere uma com:
# openssl rand -hex 32
# Fora do Docker ela so escuta em localhost; no compose quem decide a porta de fora e o
# .env da raiz (API_PORT e API_BIND).
API_KEY=
API_PORT=8080
