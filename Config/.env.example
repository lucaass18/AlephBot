# Copie para Config/.env e preencha. O arquivo real nunca vai pro git.

# discord
TOKEN=
PREFIX=!
# id do servidor de testes: registra os slash commands na hora nele.
# vazio = registro global (leva ~1h pra propagar)
DEV_GUILD_ID=

# Geral
# Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information

# musica (Lavalink) — o Lavalink/application.yml deste repositorio ja usa estes valores
LAVALINK_URI=http://localhost:2333/
LAVALINK_PASSWORD=youshallnotpass
# minutos parado (sem ninguem no canal ou sem tocar) antes do bot sair
MUSIC_IDLE_MINUTES=2

# login do YouTube, so precisa em servidor: de IP de datacenter o YouTube barra o audio.
# Ligado, o bot pede o codigo no console quando nao tem token guardado, e guarda o token
# sozinho (no volume aleph-data). Pode deixar ligado: com token guardado ele nao pede nada,
# e so volta a pedir se o Google invalidar o token.
YOUTUBE_LOGIN=false

# anime (/ma): opcional. Vazio, o bot pergunta ao Jikan (api.jikan.moe), que nao pede chave
# mas so responde quando o MyAnimeList deixa. Com um Client ID a busca vai direto na API
# oficial. Pra criar um: https://myanimelist.net/apiconfig -> Create ID (App Type: other).
MAL_CLIENT_ID=

# API HTTP de status (/api/status, /api/stats, /api/commands, /api/health): opcional.
# Vazio = desligada, nenhuma porta abre. Com uma chave (minimo 16 caracteres) ela sobe e
# todo pedido tem que mandar a chave no header X-Api-Key. Gere uma com: openssl rand -hex 32
# Fora do Docker ela so escuta em localhost; no compose quem decide a porta de fora e o
# .env da raiz (API_PORT e API_BIND).
API_KEY=
API_PORT=8080

# A IA do Scalar no /api/docs: opcional. Sem chave ela so aparece abrindo a pagina pelo
# localhost (gratis, 10 mensagens por sessao). Pra ela aparecer em outro endereco precisa
# do plano pago do Scalar (Pro ou Business): importe o /api/openapi.json em
# dashboard.scalar.com, gere a Agent key nas configuracoes do documento e cole aqui.
# Com ela a pagina tambem entrega a API_KEY pro navegador de quem abre de dentro (IP local
# ou privado, nunca pelo Funnel): e dali que a IA tira a chave pra chamar as rotas.
SCALAR_AGENT_KEY=

# Senha do /api/docs pra quem vem de fora (Funnel ou IP publico): opcional. A pagina leva a
# chave da IA no HTML, e sem senha quem tiver o link usa as suas mensagens. O navegador pede
# usuario e senha; o usuario pode ser qualquer um. De dentro a senha nunca e pedida.
API_DOCS_PASSWORD=
