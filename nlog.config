<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsole="true">

    <!-- Mesma paleta do banner (Core/Personality/Banner.cs): roxo 141 e cinza 245.
         Sao codigos ANSI 256 cores, que o alvo ColoredConsole do NLog nao alcanca
         (ele so tem as 16 cores nomeadas) - por isso o alvo aqui e o Console cru.
         Definir NO_COLOR=1 no ambiente zera todas as cores, igual no banner. -->
    <variable name="roxo"     value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;141m}" />
    <variable name="cinza"    value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;245m}" />
    <variable name="apagado"  value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;240m}" />
    <variable name="laranja"  value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;214m}" />
    <variable name="vermelho" value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;203m}" />
    <variable name="fatal"    value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[38;5;231;48;5;88m}" />
    <variable name="reset"    value="${when:when='${environment:NO_COLOR}'=='':inner=&#x1B;[0m}" />

    <!-- cor da coluna do nivel -->
    <variable name="nivelCor"
              value="${when:when=level==LogLevel.Trace:inner=${apagado}}${when:when=level==LogLevel.Debug:inner=${apagado}}${when:when=level==LogLevel.Info:inner=${roxo}}${when:when=level==LogLevel.Warn:inner=${laranja}}${when:when=level==LogLevel.Error:inner=${vermelho}}${when:when=level==LogLevel.Fatal:inner=${fatal}}" />

    <!-- a mensagem so ganha cor quando e problema; no resto herda a cor do terminal,
         que e o que mantem tudo legivel em tema claro e escuro -->
    <variable name="mensagemCor"
              value="${when:when=level==LogLevel.Trace:inner=${apagado}}${when:when=level==LogLevel.Debug:inner=${apagado}}${when:when=level==LogLevel.Warn:inner=${laranja}}${when:when=level==LogLevel.Error:inner=${vermelho}}${when:when=level==LogLevel.Fatal:inner=${fatal}}" />

    <targets>
        <target xsi:type="Console"
                name="console"
                layout="${cinza}${time}${reset}  ${nivelCor}${level:uppercase=true:padding=-5}${reset}  ${cinza}${logger:shortName=true:padding=-26}${reset}  ${mensagemCor}${message}${reset}${onexception:${newline}${vermelho}${exception:format=tostring}${reset}}" />

        <target xsi:type="File"
                name="file"
                fileName="${basedir}/logs/aleph-${shortdate}.log"
                layout="${longdate} ${level:uppercase=true:padding=-5} ${logger} - ${message}${onexception:${newline}${exception:format=tostring}}"
                maxArchiveFiles="7"
                archiveEvery="Day" />
    </targets>

    <rules>
        <!-- ruido do host/http client -->
        <logger name="Microsoft.Extensions.Hosting.*" maxlevel="Info" final="true" />
        <!-- "Application started", "Hosting environment", "Content root path" -->
        <logger name="Microsoft.Hosting.Lifetime*" maxlevel="Info" final="true" />
        <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

        <logger name="*" minlevel="Info" writeTo="console,file" />
    </rules>
</nlog>
