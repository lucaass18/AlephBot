<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>AlephBot.Tests</RootNamespace>

        <!-- o xUnit v3 roda os testes como um executável próprio -->
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

    </PropertyGroup>

    <!-- todo dotnet test deixa o relatório (.trx e .html) na TestResults da raiz; o tests/relatorio.cs
         escolhe a própria pasta e desliga isso com -p:RelatorioNaRaiz=false -->
    <PropertyGroup Condition="'$(RelatorioNaRaiz)' != 'false'">
        <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(MSBuildThisFileDirectory)..\..\TestResults" --report-xunit-trx --report-xunit-html</TestingPlatformCommandLineArguments>
    </PropertyGroup>

    <!-- e um relatorio_*.txt na mesma pasta (RelatorioTxt.cs); sem a pasta a extensão fica desligada -->
    <ItemGroup Condition="'$(RelatorioNaRaiz)' != 'false'">
        <AssemblyMetadata Include="RelatorioTxtPasta" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\TestResults'))" />
    </ItemGroup>
    <ItemGroup>
        <TestingPlatformBuilderHook Include="7C2E9A41-5B3D-4F8E-9A6C-1D2B3E4F5A60"
                                    DisplayName="RelatorioTxt"
                                    TypeFullName="AlephBot.Tests.RelatorioTxtHook" />
    </ItemGroup>

    <!-- antes de cada build (o dotnet test e o tests/relatorio.cs passam por ele), apaga da TestResults
         da raiz os relatórios com mais de 1 hora -->
    <Target Name="ApagaRelatoriosVelhos" BeforeTargets="Build">
        <ItemGroup>
            <_Relatorio Include="$(MSBuildThisFileDirectory)..\..\TestResults\**\*" />
        </ItemGroup>
        <!-- com a pasta vazia não sobra data pra ler, e a conta abaixo quebraria o build -->
        <ItemGroup Condition="'@(_Relatorio)' != ''">
            <_RelatorioVelho Include="@(_Relatorio)"
                             Condition="$([System.DateTime]::Now.Subtract($([System.DateTime]::Parse('%(_Relatorio.ModifiedTime)'))).TotalHours) &gt; 1" />
        </ItemGroup>
        <Delete Files="@(_RelatorioVelho)" ContinueOnError="true" />
    </Target>

    <ItemGroup>
      <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
      <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
      <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
      <PackageReference Include="xunit.v3" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\AlephBot\AlephBot.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Using Include="Xunit" />
    </ItemGroup>

</Project>
