<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Version>1.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <!-- os testes são outro projeto; sem isto o SDK compilaria tests/**/*.cs junto -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    </PropertyGroup>

    <!-- os testes alcançam o que é internal -->
    <ItemGroup>
      <InternalsVisibleTo Include="AlephBot.Tests" />
    </ItemGroup>

    <!-- a API roda no Kestrel, no mesmo processo do bot -->
    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
      <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
      <PackageReference Include="Lavalink4NET" Version="4.2.2" />
      <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
      <PackageReference Include="Lavalink4NET.NetCord" Version="4.2.2" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
      <PackageReference Include="NetCord" Version="1.0.0-beta.19" />
      <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.19" />
      <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.19" />
      <PackageReference Include="NetCord.Services" Version="1.0.0-beta.19" />
      <PackageReference Include="NetCordAddons.Services" Version="1.1.9" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
      <PackageReference Include="NLog" Version="6.2.0" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <!-- os emoji da ficha vão dentro do dll: o bot sobe eles sozinho no primeiro boot -->
    <ItemGroup>
      <EmbeddedResource Include="Core\Commands\Anime\Emojis\*.png" />
      <EmbeddedResource Include="Core\Personality\Emojis\*.png" />
      <EmbeddedResource Include="Core\Personality\Emojis\*.gif" />
    </ItemGroup>

    <ItemGroup>
      <None Update="nlog.config">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
