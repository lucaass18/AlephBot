    {
      "parameters": {
        "jsCode": "// uma linha por coleta, com os nomes das colunas da tabela aleph_stats\nconst s = $input.first().json;\n\nreturn [{\n  json: {\n    coletado_em: new Date().toISOString(),\n    servidores: s.guilds,\n    membros: s.members,\n    online: s.online,\n    comandos: s.commands,\n    players: s.music.players,\n    tocando: s.music.playing,\n    pausados: s.music.paused,\n    na_fila: s.music.queuedTracks,\n    memoria_mb: s.memory.workingSetMb,\n    heap_mb: s.memory.gcHeapMb,\n  },\n}];\n"
      },
